diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -464,22 +464,21 @@
 	mov		x21, #0
 
 #if defined(SWEET)
-	/* Stage 0: white 64x32 band, no stack or page tables needed. */
-	MOV64	x0, (0xFC800000 + 2368 * 4320)
-	mov		w1, #-1
-	mov		x2, #32
-	mov		x4, #4320
-Lsweet_mark_row:
-	mov		x3, #64
-	mov		x5, x0
-Lsweet_mark_pixel:
-	str		w1, [x5], #4
+	movz	x0, #0xd800
+	movk	x0, #0xfd37, lsl #16
+	movz	w1, #0xffff
+	movk	w1, #0xffff, lsl #16
+	mov	x2, #32
+	mov	x4, #5088
+9:	mov	x3, #48
+	mov	x5, x0
+8:	str	w1, [x5], #4
 	subs	x3, x3, #1
-	b.ne	Lsweet_mark_pixel
-	add		x0, x0, x4
+	b.ne	8b
+	add	x0, x0, x4
 	subs	x2, x2, #1
-	b.ne	Lsweet_mark_row
-	dsb		sy
+	b.ne	9b
+	dsb	sy
 #endif
 
 	// Set low reset vector before attempting any loads
@@ -487,6 +486,23 @@
 	add		x0, x0, EXT(LowExceptionVectorBase)@pageoff
 	MSR_VBAR_EL1_X0
 
+#if defined(SWEET)
+	movz	x0, #0xd880
+	movk	x0, #0xfd37, lsl #16
+	movz	w1, #0x0000
+	movk	w1, #0xffff, lsl #16
+	mov	x2, #32
+	mov	x4, #5088
+9:	mov	x3, #48
+	mov	x5, x0
+8:	str	w1, [x5], #4
+	subs	x3, x3, #1
+	b.ne	8b
+	add	x0, x0, x4
+	subs	x2, x2, #1
+	b.ne	9b
+	dsb	sy
+#endif
 
 	// Get the kernel memory parameters from the boot args
 	ldr		x22, [x20, BA_VIRT_BASE]			// Get the kernel virt base
@@ -643,6 +659,21 @@
 	lsr		x12, x12, #(ARM_TT_L2_SHIFT)
 	add		x13, x25, #(2 * PGBYTES)
 	str		x11, [x13, x12, lsl #TTE_SHIFT]
+	movz	x0, #0xd900
+	movk	x0, #0xfd37, lsl #16
+	movz	w1, #0xff00
+	movk	w1, #0xff00, lsl #16
+	mov	x2, #32
+	mov	x4, #5088
+9:	mov	x3, #48
+	mov	x5, x0
+8:	str	w1, [x5], #4
+	subs	x3, x3, #1
+	b.ne	8b
+	add	x0, x0, x4
+	subs	x2, x2, #1
+	b.ne	9b
+	dsb	sy
 #endif
 
 	/* Ensure TTEs are visible */
@@ -668,6 +699,23 @@
  *	TPIDRRO_EL0 - CPU number
  */
 common_start:
+#if defined(SWEET)
+	movz	x0, #0xd980
+	movk	x0, #0xfd37, lsl #16
+	movz	w1, #0x00ff
+	movk	w1, #0xff00, lsl #16
+	mov	x2, #32
+	mov	x4, #5088
+9:	mov	x3, #48
+	mov	x5, x0
+8:	str	w1, [x5], #4
+	subs	x3, x3, #1
+	b.ne	8b
+	add	x0, x0, x4
+	subs	x2, x2, #1
+	b.ne	9b
+	dsb	sy
+#endif
 
 #if HAS_NEX_PG
 	mov x19, lr
@@ -679,8 +727,52 @@
 	adrp	x0,     EXT(sysreg_restore)@page		// Load TCR value from the system register restore structure
 	add		x0, x0, EXT(sysreg_restore)@pageoff
 	ldr		x1, [x0, SR_RESTORE_TCR_EL1]
+
+#if defined(SWEET)
+	/* stage 9: TCR value loaded (olive) */
+	movz	x0, #0xdc80
+	movk	x0, #0xfd37, lsl #16
+	movz	w1, #0x8000
+	movk	w1, #0xff00, lsl #16
+	mov	x2, #32
+	mov	x4, #5088
+3:	mov	x3, #48
+	mov	x5, x0
+2:	str	w1, [x5], #4
+	subs	x3, x3, #1
+	b.ne	2b
+	add	x0, x0, x4
+	subs	x2, x2, #1
+	b.ne	3b
+	dsb	sy
+
+	/* The 16K bootstrap tables require TG0=16KB; the built-in initializer
+	 * carries TG0=64KB, which the walk cannot use. Force bits [15:14]=01. */
+	movz	x9, #0x8000
+	bic	x1, x1, x9
+	orr	x1, x1, #0x4000
+#endif
 	MSR_TCR_EL1_X1
 
+#if defined(SWEET)
+	/* stage 6: TCR written (cyan) */
+	movz	x0, #0xdb00
+	movk	x0, #0xfd37, lsl #16
+	movz	w1, #0xffff
+	movk	w1, #0x00ff, lsl #16
+	mov	x2, #32
+	mov	x4, #5088
+5:	mov	x3, #48
+	mov	x5, x0
+4:	str	w1, [x5], #4
+	subs	x3, x3, #1
+	b.ne	4b
+	add	x0, x0, x4
+	subs	x2, x2, #1
+	b.ne	5b
+	dsb	sy
+#endif
+
 	/* Set up translation table base registers.
 	 *	TTBR0 - V=P table @ top of kernel
 	 *	TTBR1 - KVA table @ top of kernel + 1 page
@@ -698,6 +790,25 @@
 	and		x0, x0, #(TTBR_BADDR_MASK)
 	MSR_TTBR1_EL1_X0
 
+#if defined(SWEET)
+	/* stage 7: TTBR0/1 written (orange) */
+	movz	x0, #0xdb80
+	movk	x0, #0xfd37, lsl #16
+	movz	w1, #0x8000
+	movk	w1, #0xffff, lsl #16
+	mov	x2, #32
+	mov	x4, #5088
+5:	mov	x3, #48
+	mov	x5, x0
+4:	str	w1, [x5], #4
+	subs	x3, x3, #1
+	b.ne	4b
+	add	x0, x0, x4
+	subs	x2, x2, #1
+	b.ne	5b
+	dsb	sy
+#endif
+
 	// Set up MAIR attr0 for normal memory, attr1 for device memory
 	mov		x0, xzr
 	mov		x1, #(MAIR_WRITEBACK << MAIR_ATTR_SHIFT(CACHE_ATTRINDX_WRITEBACK))
@@ -721,6 +832,25 @@
 	tlbi	vmalle1
 	dsb		ish
 
+#if defined(SWEET)
+	/* stage 8: MAIR+TLBI done (purple) */
+	movz	x0, #0xdc00
+	movk	x0, #0xfd37, lsl #16
+	movz	w1, #0x00ff
+	movk	w1, #0xffff, lsl #16
+	mov	x2, #32
+	mov	x4, #5088
+5:	mov	x3, #48
+	mov	x5, x0
+4:	str	w1, [x5], #4
+	subs	x3, x3, #1
+	b.ne	4b
+	add	x0, x0, x4
+	subs	x2, x2, #1
+	b.ne	5b
+	dsb	sy
+#endif
+
 
 #if defined(BCM2837)
 	// Setup timer interrupt routing; must be done before MMU is enabled
@@ -781,6 +911,25 @@
 	MSR_SCTLR_EL1_X0
 	isb		sy
 
+#if defined(SWEET)
+	/* stage 4: MMU just enabled (yellow) */
+	movz	x0, #0xda00
+	movk	x0, #0xfd37, lsl #16
+	movz	w1, #0xff00
+	movk	w1, #0xffff, lsl #16
+	mov	x2, #32
+	mov	x4, #5088
+7:	mov	x3, #48
+	mov	x5, x0
+6:	str	w1, [x5], #4
+	subs	x3, x3, #1
+	b.ne	6b
+	add	x0, x0, x4
+	subs	x2, x2, #1
+	b.ne	7b
+	dsb	sy
+#endif
+
 #if !VMAPPLE && !defined(SWEET)
 	MOV64   x1, SCTLR_EL1_DEFAULT
 	cmp		x0, x1
@@ -826,6 +975,25 @@
 	// If x21 != 0, we're doing a warm reset, so we need to trampoline to the kernel pmap.
 	cbnz	x21, Ltrampoline
 
+#if defined(SWEET)
+	/* stage 5: about to call arm_init (magenta) */
+	movz	x0, #0xda80
+	movk	x0, #0xfd37, lsl #16
+	movz	w1, #0x00ff
+	movk	w1, #0xffff, lsl #16
+	mov	x2, #32
+	mov	x4, #5088
+7:	mov	x3, #48
+	mov	x5, x0
+6:	str	w1, [x5], #4
+	subs	x3, x3, #1
+	b.ne	6b
+	add	x0, x0, x4
+	subs	x2, x2, #1
+	b.ne	7b
+	dsb	sy
+#endif
+
 	// Set KVA of boot args as first arg
 	add		x0, x20, x22
 	sub		x0, x0, x23
